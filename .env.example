HUBSPOT_SCOPES=oauth crm.objects.contacts.read crm.objects.contacts.write crm.schemas.contacts.read crm.schemas.contacts.write crm.objects.companies.read crm.objects.companies.write crm.schemas.companies.read crm.schemas.companies.write crm.objects.products.read crm.objects.products.write crm.objects.deals.read crm.objects.deals.write crm.schemas.deals.read crm.schemas.deals.write crm.pipelines.orders.read crm.objects.owners.read crm.objects.line_items.read crm.objects.line_items.write crm.schemas.line_items.read e-commerce
SAP_SYNC_CRON_ENABLED=false

# ─── Auth ─────────────────────────────────────────────────────────────────────
INTERNAL_KEY=
JWT_SECRET=test
# Firma la sesión del panel de soporte (/panel/api). Distinta de JWT_SECRET. Sin ella el panel
# queda apagado. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PANEL_JWT_SECRET=
# IPs o rangos CIDR de los proxies propios delante del panel (separados por coma), p. ej. la
# subred de la red Docker que comparten el proxy con TLS y el contenedor del panel. Sin ella, el
# límite de logins por IP queda apagado. Nunca poner rangos amplios (0.0.0.0/0).
PANEL_TRUSTED_PROXIES=

# ─── SAP – campos adicionales por entidad ────────────────────────────────────
COMPANY_ADD_FIELDS_URL_SAP=ContactEmployees,BPAddresses
PRODUCT_ADD_FIELDS_URL_SAP=ItemWarehouseInfoCollection,ItemPrices
DEAL_ADD_FIELDS_URL_SAP=DocEntry,DocNum,DocumentStatus

WEBHOOK_EVENT_BATCH_SIZE=10
WEBHOOK_EVENT_MAX_RETRIES=3
WEBHOOK_WORKER_CONCURRENCY=5


